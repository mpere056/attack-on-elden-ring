<Project Sdk="Microsoft.NET.Sdk">
  <!-- BepInEx 6 (IL2CPP) plugin for AoTTG2. Build: python tools/build_guest.py
       References point into the AoTTG2 install (BepInEx core + generated interop). Nothing from
       there is copied into this repository or the build output. -->
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>AoerBridge</AssemblyName>
    <RootNamespace>Aoer</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>CA1416</NoWarn> <!-- Windows-only on purpose: shared memory with Elden Ring -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <BepCore>$(AoTTG2Dir)\BepInEx\core</BepCore>
    <Interop>$(AoTTG2Dir)\BepInEx\interop</Interop>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="BepInEx.Core" HintPath="$(BepCore)\BepInEx.Core.dll" Private="false" />
    <Reference Include="BepInEx.Unity.IL2CPP" HintPath="$(BepCore)\BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="Il2CppInterop.Runtime" HintPath="$(BepCore)\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="Il2CppInterop.Common" HintPath="$(BepCore)\Il2CppInterop.Common.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(BepCore)\0Harmony.dll" Private="false" />
    <Reference Include="Il2Cppmscorlib" HintPath="$(Interop)\Il2Cppmscorlib.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(Interop)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.ScreenCaptureModule" HintPath="$(Interop)/UnityEngine.ScreenCaptureModule.dll" Private="false" />
    <Reference Include="UnityEngine.InputLegacyModule" HintPath="$(Interop)\UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="UnityEngine.PhysicsModule" HintPath="$(Interop)\UnityEngine.PhysicsModule.dll" Private="false" />
    <Reference Include="Scripts" HintPath="$(Interop)\Scripts.dll" Private="false" />
    <Reference Include="Photon3Unity3D" HintPath="$(Interop)\Photon3Unity3D.dll" Private="false" />
    <Reference Include="PhotonRealtime" HintPath="$(Interop)\PhotonRealtime.dll" Private="false" />
    <Reference Include="PhotonUnityNetworking" HintPath="$(Interop)\PhotonUnityNetworking.dll" Private="false" />
  </ItemGroup>
</Project>
